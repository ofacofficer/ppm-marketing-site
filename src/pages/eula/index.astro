  "description": "The End-User License Agreement governing use of the Proactive Property Management owner portal, resident portal, and PPM AI Operating System.",
  "canonical": "https://www.njpropertymanager.com/eula/",
  "twitter": {
    "site": true
  },
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "End-User License Agreement",
      "url": "https://www.njpropertymanager.com/eula/",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Proactive Property Management",
        "url": "https://www.njpropertymanager.com"
      }
    }
