---
// /blog/nj-landlord-law/: a one-off page. The body is src/bodies/blog/nj-landlord-law/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout. The list of
// every post in this pillar is generated from content/blog (src/lib/content-index.mjs).
import Page from '../../../layouts/Page.astro';
import { site } from '../../../site.config.mjs';
import { getCollection } from 'astro:content';
import { postEntries, pillarPostsHtml, fillMarker } from '../../../lib/content-index.mjs';
import main from '../../../bodies/blog/nj-landlord-law/main.html?raw';
import css from '../../../bodies/blog/nj-landlord-law/page.css?raw';

const page = {
  "title": "New Jersey Landlord-Tenant Law: The Complete Guide (2026) | PPM",
