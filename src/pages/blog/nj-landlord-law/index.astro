      "description": "New Jersey landlord-tenant law explained — security deposits, eviction rules, rent control, habitability standards, required disclosures, and lease requirements. Updated 2026.",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.njpropertymanager.com/blog/nj-landlord-law/"
      },
      "image": "https://www.njpropertymanager.com/og-image.jpg",
      "publisher": {
        "@type": "Organization",
        "name": "Proactive Property Management",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.njpropertymanager.com/images/logo-white-horizontal.png"
