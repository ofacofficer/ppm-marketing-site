  ]
};
const entries = postEntries((await getCollection('blog')).map((p) => p.data));
const body = fillMarker(main, 'pillar-posts', pillarPostsHtml(entries, 'blog/nj-landlord-law', 'NJ Landlord Law'));
---
<Page {...page} main={body} css={css} />
