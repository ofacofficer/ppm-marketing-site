    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.njpropertymanager.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
