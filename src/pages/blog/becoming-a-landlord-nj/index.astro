import { postEntries, pillarPostsHtml, fillMarker } from '../../../lib/content-index.mjs';
import main from '../../../bodies/blog/becoming-a-landlord-nj/main.html?raw';
import css from '../../../bodies/blog/becoming-a-landlord-nj/page.css?raw';

