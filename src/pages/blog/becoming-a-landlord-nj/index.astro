        "@id": "https://www.njpropertymanager.com/blog/becoming-a-landlord-nj/"
      },
      "image": "https://www.njpropertymanager.com/og-image.jpg",
      "publisher": {
        "@type": "Organization",
        "name": "Proactive Property Management",
