const entries = postEntries((await getCollection('blog')).map((p) => p.data));
const body = fillMarker(main, 'pillar-posts', pillarPostsHtml(entries, 'blog/becoming-a-landlord-nj', 'Getting Started as a NJ Landlord'));
---
