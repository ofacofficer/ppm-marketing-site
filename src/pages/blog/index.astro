---
// /blog/: a one-off page. The body is src/bodies/blog/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout. The
// "Latest articles" list and the posts under each topic are generated from content/blog
// (src/lib/content-index.mjs) at the body's <!--GENERATED:...--> markers.
import Page from '../../layouts/Page.astro';
import { site } from '../../site.config.mjs';
import { getCollection } from 'astro:content';
import { postEntries, latestArticlesHtml, topicPostsHtml, fillMarker } from '../../lib/content-index.mjs';
import main from '../../bodies/blog/main.html?raw';
import css from '../../bodies/blog/page.css?raw';

const page = {
  "title": "Property Management Resources for NJ Landlords | PPM Blog",
  "description": "NJ landlord law, property management costs, rental market guides, tenant screening, and maintenance — practical resources for Northern & Central NJ property owners.",
  "canonical": "https://www.njpropertymanager.com/blog/",
  "og": {
    "title": "NJ Landlord Resources & Guides | Proactive Property Management",
    "description": "Practical guides on NJ landlord law, property management costs, rental markets, tenant screening, and real estate investing. Written by PPM for NJ landlords."
  },
  "twitter": {
    "site": true
  },
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": [
        "LocalBusiness",
        "ProfessionalService"
      ],
      "@id": "https://www.njpropertymanager.com/#business",
      "name": "Proactive Property Management",
      "alternateName": "PPM",
      "url": "https://www.njpropertymanager.com",
      "telephone": site.phone.e164,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jersey City",
        "addressRegion": "NJ",
        "addressCountry": "US"
      }
    }
  ]
};
const entries = postEntries((await getCollection('blog')).map((p) => p.data));
let body = fillMarker(main, 'latest-articles', latestArticlesHtml(entries));
for (const [, pillar] of main.matchAll(/<!--GENERATED:topic-posts:([a-z0-9/-]+)-->/g))
  body = fillMarker(body, `topic-posts:${pillar}`, topicPostsHtml(entries, pillar));
---
<Page {...page} main={body} css={css} />
