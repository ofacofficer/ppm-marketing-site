---
// /service-areas/: a one-off page. The body is src/bodies/service-areas/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout. The list of
// area pages, grouped by county, is generated from content/areas (src/lib/content-index.mjs); the
// hand-written "other towns we serve" rows drop a town as soon as it has its own page.
import Page from '../../layouts/Page.astro';
import { site } from '../../site.config.mjs';
import { getCollection } from 'astro:content';
import { areaIndexHtml, withoutPublishedTowns, fillMarker } from '../../lib/content-index.mjs';
import main from '../../bodies/service-areas/main.html?raw';
import css from '../../bodies/service-areas/page.css?raw';

const page = {
  "title": "Property Management Service Areas | Northern & Central NJ | PPM",
  "description": "Proactive Property Management serves landlords across Northern and Central New Jersey. Find your city to learn about local rental markets and our management services.",
  "canonical": "https://www.njpropertymanager.com/service-areas/",
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": [
        "LocalBusiness",
        "ProfessionalService"
      ],
      "@id": "https://www.njpropertymanager.com/#business",
      "name": "Proactive Property Management",
      "alternateName": "PPM",
      "url": "https://www.njpropertymanager.com",
      "telephone": site.phone.e164,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jersey City",
        "addressRegion": "NJ",
        "addressCountry": "US"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.njpropertymanager.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Areas",
          "item": "https://www.njpropertymanager.com/service-areas/"
        }
      ]
    }
  ]
};
const areas = (await getCollection('areas')).map((a) => ({ slug: a.id, data: a.data }));
let body = fillMarker(withoutPublishedTowns(main, areas), 'area-index', areaIndexHtml(areas, 'data-astro-cid-75uxgust'));
// Once every hand-written town has its own page, drop the empty "other towns" heading and list.
body = body.replace(/<h2 class="area-county-head"[^>]*>Other towns we serve<\/h2> <div class="areas-list"[^>]*>\s*<\/div>/, '');
---
<Page {...page} main={body} css={css} />
