---
// /pricing/ (Phase 3): a two-column fee ledger, "You pay" and "You don't pay", then the FAQ. The
// visible FAQ and its FAQPage JSON-LD are rendered from the one list below, so they cannot drift.
//
// Fee schedule v3 (held until Dan signs it in the OS). Every figure here is the v3 schedule's:
// 10% of rent collected, never more than $275 or less than $150 per unit per month; $195 onboarding
// up to 4 units plus $50 per unit beyond, deducted from the first payout; a $395 new-lease fee, and
// where local law bars tenant-paid leasing commissions (Newark) a leasing commission quoted before we
// list; $250 per renewal. The $150 minimum applies only in a month the rent is collected in full (Dan,
// 2026-11-10). Who earns the leasing commission is not stated on the site (Dan, 2026-11-10: "No need to
// reveal that on our website"). The callout under the fees ("In New Jersey commissions are negotiable" and
// the supervising-broker line) was removed at Dan's request (2026-11-10); the statement stays in the FAQ
// below and the broker line in the site footer.
//
// Copy note: the strings below are live site copy (Blake drafts, Dan approves, the CCO checks claims).
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/FaqList.astro';
import { site } from '../../site.config.mjs';
import { faqJsonLd } from '../../lib/faq.mjs';
import css from '../../bodies/pricing/page.css?raw';

const included = [
  'Rent collection and owner disbursements',
  'Tenant communication and maintenance coordination',
  'Maintenance requests received 24/7',
  'Monthly financial statements via owner portal',
  'Lease enforcement',
  'NJ landlord-tenant law compliance',
  'Routine property inspections',
];
const asNeeded = [
  { name: 'Eviction coordination', fee: '$250', note: 'Attorney and court costs are passed through at cost.' },
  { name: 'Project supervision', fee: '8%', note: 'Of a project over $5,000, and only if you opt in for that project.' },
  { name: 'Additional inspection', fee: '$100', note: 'Each, beyond the routine inspections.' },
];
const notCharged = [
  { name: 'Maintenance markups', note: 'None. You see the actual vendor invoice.' },
  { name: 'Technology fees', note: 'None.' },
  { name: 'Vacancy fees', note: 'None.' },
  { name: 'Hidden fees', note: 'None.' },
  { name: 'Cancellation fees', note: 'None. Cancel with 30 days written notice.' },
  { name: 'A share of late fees', note: 'None. Late fees belong to you.' },
];
const faq = [
  { question: 'Do you charge based on rent collected or rent due?', answer: 'Collected. The management fee is 10% of the rent we collect for you, never more than $275 per unit per month. The $150 per-unit minimum applies only in a month the rent is collected in full, so if the tenant doesn’t pay, we don’t get paid that month.' },
  { question: 'What does onboarding cost?', answer: 'Onboarding is $195 for up to 4 units, plus $50 for each unit beyond 4. A 5-unit property is $245. We deduct it from your first payout rather than billing you upfront.' },
  { question: 'What does the $395 new-lease fee cover?', answer: 'Our own lease-up work for each new lease: screening against our written criteria, the lease and signing, the move-in inspection, security-deposit setup and tenant portal setup.' },
  { question: 'Is there a leasing commission on top of the new-lease fee?', answer: 'Where local law bars tenant-paid leasing commissions (for example, Newark), a leasing commission applies and is quoted to you before we list.' },
  { question: 'Is there a renewal fee?', answer: 'Yes, $250 per lease renewal. It covers the market rent review, the NJ-compliant notices and the renewal lease.' },
  { question: 'Do you mark up maintenance costs?', answer: 'No. You see the actual vendor invoice. PPM does not add a percentage on top of repair costs.' },
  { question: 'Is there a minimum portfolio size?', answer: 'No minimum. We work with landlords who own one rental unit as well as investors with larger portfolios. Properties with more than 10 units are quoted individually.' },
  { question: 'Can I cancel the management agreement?', answer: 'Yes. Give us 30 days written notice. There is no cancellation fee.' },
  { question: 'Are these fees negotiable?', answer: 'In New Jersey commissions are negotiable. These are our standard fees, and we confirm the fees for your property in writing before you sign.' },
];

const page = {
  title: 'Property Management Pricing | Proactive Property Management NJ',
  description: 'PPM charges 10% of monthly rent collected, never more than $275 per unit ($150 minimum in full-collection months). $195 onboarding, $395 per new lease, $250 renewal.',
  canonical: 'https://www.njpropertymanager.com/pricing/',
  og: {
    title: 'Property Management Pricing NJ | Simple, Transparent | PPM',
    description: '10% of monthly rent collected, never more than $275 per unit, and at least $150 in a month the rent is collected in full. $195 onboarding, a $395 new-lease fee and $250 per renewal. No maintenance markups, technology fees or vacancy fees.',
  },
  twitter: { site: true },
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': 'https://www.njpropertymanager.com/#business',
      name: 'Proactive Property Management',
      alternateName: 'PPM',
      url: 'https://www.njpropertymanager.com',
      telephone: site.phone.e164,
      email: site.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Jersey City', addressRegion: 'NJ', addressCountry: 'US' },
    },
    faqJsonLd(faq),
  ],
  css,
};
---
<Base {...page}>
<main id="main">
<section class="page-hero">
  <div class="wrap">
    <h1>Property management pricing</h1>
    <p class="lead">10% of monthly rent collected — never more than $275 per unit, and at least $150 in any month the rent is collected in full. No maintenance markups, no technology fees, no vacancy fees.</p>
  </div>
</section>

<section class="ledger-block" aria-label="Fees">
  <div class="wrap ledger">
    <div class="ledger-col" aria-labelledby="pay-title">
      <h2 id="pay-title" class="ledger-head">You pay</h2>
      <dl class="ledger-list">
        <div class="ledger-row">
          <dt>Monthly management fee</dt>
          <dd>
            <span class="fee-figure">10%</span>
            <span class="fee-unit">of monthly rent collected</span>
            <p>Never more than $275 per unit per month. In any month the rent is collected in full, at least $150 per unit. It is charged on rent collected, not rent due: if the tenant doesn’t pay, we don’t get paid that month. Properties with more than 10 units are quoted individually.</p>
          </dd>
        </div>
        <div class="ledger-row">
          <dt>Onboarding</dt>
          <dd>
            <span class="fee-figure">$195</span>
            <span class="fee-unit">one time, up to 4 units</span>
            <p>Plus $50 for each unit beyond 4. Deducted from your first payout, not billed upfront.</p>
          </dd>
        </div>
        <div class="ledger-row">
          <dt>New-lease fee</dt>
          <dd>
            <span class="fee-figure">$395</span>
            <span class="fee-unit">per new lease</span>
            <p>Our lease-up work: screening against our written criteria, the lease and signing, the move-in inspection, security-deposit setup and tenant portal setup. Where local law bars tenant-paid leasing commissions (for example, Newark), a leasing commission applies and is quoted to you before we list.</p>
          </dd>
        </div>
        <div class="ledger-row">
          <dt>Lease renewal</dt>
          <dd>
            <span class="fee-figure">$250</span>
            <span class="fee-unit">per renewal</span>
            <p>Market rent review, NJ-compliant notices and the renewal lease.</p>
          </dd>
        </div>
      </dl>
      <h3 class="covers-head">Only when needed</h3>
      <dl class="ledger-list as-needed">
        {asNeeded.map((f) => (
          <div class="ledger-row"><dt>{f.name}</dt><dd><span class="fee-small">{f.fee}</span><p>{f.note}</p></dd></div>
        ))}
      </dl>
      <h3 class="covers-head">The management fee covers</h3>
      <ul class="covers">{included.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="ledger-col" aria-labelledby="nopay-title">
      <h2 id="nopay-title" class="ledger-head">You don’t pay</h2>
      <dl class="ledger-list">
        {notCharged.map((f) => (
          <div class="ledger-row"><dt>{f.name}</dt><dd><p>{f.note}</p></dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="pricing-cta" aria-labelledby="pricing-cta-title">
  <div class="wrap pricing-cta-inner">
    <div>
      <h2 id="pricing-cta-title">Get your quote</h2>
      <p>We’ll tell you what your property should rent for and confirm the fees for your property in writing, with no obligation. Or call <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
    <a href={site.nav.cta.href} class="btn btn-gold">{site.nav.cta.label}</a>
  </div>
</section>

<section class="pricing-faq" aria-labelledby="pricing-faq-title">
  <div class="wrap">
    <h2 id="pricing-faq-title">Pricing questions</h2>
    <FaqList items={faq} />
  </div>
</section>
</main>
</Base>
