---
// /contact/: a one-off page. The body is src/bodies/contact/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout.
import Page from '../../layouts/Page.astro';
import { site } from '../../site.config.mjs';
import main from '../../bodies/contact/main.html?raw';
import css from '../../bodies/contact/page.css?raw';

const page = {
  "title": "Get a Free Rental Analysis | Proactive Property Management NJ",
  "description": `Get a free rental analysis for your Northern or Central NJ property. No cost, no commitment. Call ${site.phone.display} or fill out the form.`,
  "canonical": "https://www.njpropertymanager.com/contact/",
  "og": {
    "title": "Free Rental Analysis | Proactive Property Management NJ",
    "description": `Get a free rental analysis for your NJ property. We'll tell you what it should rent for — no cost, no commitment, no sales pressure. Call ${site.phone.display}.`
  },
  "twitter": {
    "site": true
  },
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": [
        "LocalBusiness",
        "ProfessionalService"
      ],
      "@id": "https://www.njpropertymanager.com/#business",
      "name": "Proactive Property Management",
      "alternateName": "PPM",
      "url": "https://www.njpropertymanager.com",
      "telephone": site.phone.e164,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jersey City",
        "addressRegion": "NJ",
        "addressCountry": "US"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact Proactive Property Management",
      "url": "https://www.njpropertymanager.com/contact/"
    }
  ],
  "bodyClass": "page-contact",
  "leadScript": "contact"
};
---
<Page {...page} main={main} css={css} />
