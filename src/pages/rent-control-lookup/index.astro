---
// /rent-control-lookup/: a one-off page. The body is src/bodies/rent-control-lookup/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout.
import Page from '../../layouts/Page.astro';
import { site } from '../../site.config.mjs';
import main from '../../bodies/rent-control-lookup/main.html?raw';
import css from '../../bodies/rent-control-lookup/page.css?raw';

const page = {
  "title": "NJ Rent Control Lookup by Municipality | Proactive Property Management",
  "description": "Look up whether a New Jersey municipality has rent control and what that means for rent increases. A free lookup tool for NJ landlords from Proactive Property Management.",
  "canonical": "https://www.njpropertymanager.com/rent-control-lookup/",
  "og": {
    "title": "NJ Rent Control Lookup by Municipality | PPM",
    "description": "Look up whether a New Jersey municipality has rent control and what that means for rent increases. A free lookup tool for NJ landlords."
  },
  "twitter": {
    "site": true
  },
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": [
        "LocalBusiness",
        "ProfessionalService"
      ],
      "@id": "https://www.njpropertymanager.com/#business",
      "name": "Proactive Property Management",
      "alternateName": "PPM",
      "url": "https://www.njpropertymanager.com",
      "telephone": site.phone.e164,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jersey City",
        "addressRegion": "NJ",
        "addressCountry": "US"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.njpropertymanager.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rent Control Lookup",
          "item": "https://www.njpropertymanager.com/rent-control-lookup/"
        }
      ]
    }
  ]
};
---
<Page {...page} main={main} css={css} />
