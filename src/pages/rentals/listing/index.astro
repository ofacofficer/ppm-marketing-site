---
// /rentals/listing/: a one-off page. The body is src/bodies/rentals/listing/main.html,
// verbatim from the Phase 0 site; the head, header and footer come from the shared layout.
import Page from '../../../layouts/Page.astro';
import { site } from '../../../site.config.mjs';
import main from '../../../bodies/rentals/listing/main.html?raw';
import css from '../../../bodies/rentals/listing/page.css?raw';
import extra1 from '../../../bodies/rentals/listing/extra-1.css?raw';

const page = {
  "title": "Available Rental | Proactive Property Management",
  "description": "View details, photos, and availability for this rental home managed by Proactive Property Management, and send an inquiry or request a showing.",
  "canonical": "https://www.njpropertymanager.com/rentals/listing/",
  "og": {
    "title": "Tenant Resources | Proactive Property Management NJ",
    "description": "Resources for tenants in PPM-managed properties: how to pay rent, submit a maintenance request, and reach us with questions about your lease.",
    "url": "https://www.njpropertymanager.com/tenants/"
  },
  "twitter": {
    "site": true
  },
  "jsonLd": [
    {
      "@context": "https://schema.org",
      "@type": [
        "LocalBusiness",
        "ProfessionalService"
      ],
      "@id": "https://www.njpropertymanager.com/#business",
      "name": "Proactive Property Management",
      "alternateName": "PPM",
      "url": "https://www.njpropertymanager.com",
      "telephone": site.phone.e164,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jersey City",
        "addressRegion": "NJ",
        "addressCountry": "US"
      }
    }
  ],
  "footerTail": "tenantFacing"
};
---
<Page {...page} main={main} css={css} extraStyles={[extra1]} />
