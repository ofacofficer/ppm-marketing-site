---
// One JSON-LD block. `data` is an object (serialized here) or a pre-serialized JSON string.
// "<" is escaped so no value can close the script element early.
interface Props { data: unknown }
const { data } = Astro.props;
const json = (typeof data === 'string' ? data : JSON.stringify(data)).replace(/</g, '\\u003c');
---
<script type="application/ld+json" is:inline set:html={json} />
