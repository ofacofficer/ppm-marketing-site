---
// A service-area page, rendered from content/areas/<slug>.json: a town (the default) or a county
// (kind "county"). Adding one is one JSON file (plus, optionally, its hero photo in
// public/images/service-areas/); the URL, layout, CTA, ProfessionalService, BreadcrumbList and
// FAQPage JSON-LD all come from here. The optional fields (docs/CONTENT_SCHEMA.md) add a county's
// town list, "Local rules at a glance" with a source for every fact, a visible FAQ, and the updated
// date. A county page's areaServed is an AdministrativeArea; a town's is a City.
//
// Phase 4 (DESIGN.md §6 "No overlap"): the top section is option C (pale sky field, navy type) and
// the photo has its own column instead of sitting behind the headline (REDESIGN_PLAN.md F9). A CC
// BY-SA photo shows its credit as a visible caption (public/images/service-areas/CREDITS.md).
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FAQ from '../components/FAQ.astro';
import FaqList from '../components/FaqList.astro';
import { site } from '../site.config.mjs';
import { scope } from '../components/scope.mjs';
import { expandTokens } from '../lib/tokens.mjs';
import { postDates } from '../lib/post-body.mjs';
import areaCss from '../styles/area.css?raw';

export interface AreaData {
  /** "town" (default) or "county". */
  kind?: 'town' | 'county';
  name: string;
  county: string;
  /** True when the town has a municipal rent control ordinance (the hero says so and links the lookup). */
  rentControl: boolean;
  seo: { title: string; description: string; social?: { title?: string; description?: string }; twitter?: { site?: boolean; title?: string; description?: string } };
  h1: string;
  intro: string;
  /** Hero photo: public/images/service-areas/<image>-hero.jpg, -hero.webp and -hero-768.webp. */
  hero?: { image: string; webpWidth: number; width: number; height: number; alt: string; creditHtml?: string };
  breadcrumbHubLabel: string;
  /** The town's own copy for the main column (services, market, at-a-glance, rent-control notes). */
  contentHtml: string;
  /** ctaText is kept in the data for the OS publisher's schema; the page no longer renders a sidebar CTA. */
  sidebar: { ctaText: string; nearbyLabel: string; nearby: { href: string; label: string }[]; guides: { href: string; label: string }[] };
  cta: { heading: string; text: string };
  /** County pages: slugs of its town pages (resolved by the route into `towns`). */
  towns?: string[];
  faq?: { question: string; answer: string }[];
  localFacts?: { label: string; text: string; sourceTitle: string; sourceUrl: string }[];
  datePublished?: string;
  dateModified?: string;
}
type Link = { href: string; label: string };
interface Props {
  slug: string;
  area: AreaData;
  /** County pages: the town pages it lists, resolved from area.towns. */
  towns?: Link[];
  /** Town pages: the county page this town sits under, when one exists (breadcrumb). */
  countyPage?: Link;
}
const { slug, area, towns = [], countyPage } = Astro.props;
const isCounty = area.kind === 'county';
const lastDate = area.dateModified || area.datePublished;
const crumbs: Link[] = [{ href: '/', label: 'Home' }, { href: '/service-areas/', label: area.breadcrumbHubLabel }, ...(countyPage ? [countyPage] : [])];
const url = `${site.baseUrl}/service-areas/${slug}/`;
const cid = 'area';
const s = scope(cid);
const heroImg = area.hero && `/images/service-areas/${area.hero.image}-hero`;
const lookupHref = `/rent-control-lookup/?town=${encodeURIComponent(area.name)}`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService',
    name: `${site.name} — ${area.name}, NJ`, url, telephone: site.phone.e164, priceRange: '$$',
    image: area.hero ? `${site.baseUrl}${heroImg}.jpg` : site.ogImage,
    areaServed: isCounty
      ? { '@type': 'AdministrativeArea', name: area.name, containedInPlace: { '@type': 'State', name: 'New Jersey' } }
      : { '@type': 'City', name: area.name, addressRegion: 'NJ' },
    parentOrganization: { '@type': 'LocalBusiness', name: site.name, url: site.baseUrl },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.baseUrl}/` },
      ...crumbs.slice(1).map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.label, item: `${site.baseUrl}${c.href}` })),
      { '@type': 'ListItem', position: crumbs.length + 1, name: area.name, item: url },
    ],
  },
];
---
<Base title={area.seo.title} description={area.seo.description} canonical={url} og={area.seo.social} twitter={area.seo.twitter} jsonLd={jsonLd} css={areaCss}>
<FAQ slot="head" items={area.faq ?? []} />
<main id="main">
<Breadcrumbs variant="area" cid={cid} items={crumbs} current={area.name} />
<section class={area.hero ? 'city-hero area-hero' : 'city-hero area-hero no-photo'} aria-labelledby="area-title">
  <div class="wrap area-hero-grid">
    <div class="area-hero-text">
      <p class="area-county">{area.county}</p>
      <h1 id="area-title">{area.h1}</h1>
      <p class="lead">{area.intro}</p>
      <p class="area-rc">
        {isCounty
          ? <>Rent control in New Jersey is set town by town. <a href="/rent-control-lookup/">Check a town in our rent control lookup</a></>
          : area.rentControl
          ? <>{area.name} has a municipal rent control ordinance. <a href={lookupHref}>Look up {area.name} in our rent control lookup</a></>
          : <a href={lookupHref}>Check rent control for {area.name}</a>}
      </p>
      <div class="area-actions">
        <a href={site.nav.cta.href} class="btn btn-primary">{site.nav.cta.label}</a>
        <a href={`tel:${site.phone.tel}`} class="btn btn-ghost">{site.phone.display}</a>
      </div>
    </div>
    {area.hero && (
      <figure class="area-photo">
        <picture>
          <source type="image/webp" srcset={`${heroImg}-768.webp 768w, ${heroImg}.webp ${area.hero.webpWidth}w`} sizes="(min-width: 1024px) 560px, 100vw">
          <img src={`${heroImg}.jpg`} alt={area.hero.alt} width={area.hero.width} height={area.hero.height} fetchpriority="high" decoding="async">
        </picture>
        {area.hero.creditHtml && <figcaption class="area-credit" set:html={area.hero.creditHtml} />}
      </figure>
    )}
  </div>
</section>
<section class="area-body">
  <div class="wrap area-grid">
    <div class="prose-content area-prose">
      <Fragment set:html={expandTokens(area.contentHtml)} />
      {towns.length > 0 && <section class="area-extra" aria-labelledby="area-towns"><h2 id="area-towns">Towns we serve in {area.name}</h2><ul>{towns.map((t) => <li><a href={t.href}>{t.label}</a></li>)}</ul></section>}
      {area.localFacts && <section class="area-extra" aria-labelledby="area-local-facts"><h2 id="area-local-facts">Local rules at a glance</h2><dl class="local-facts">{area.localFacts.map((f) => <><dt>{f.label}</dt><dd>{f.text} <span class="fact-source">Source: <a href={f.sourceUrl} rel="noopener" target="_blank">{f.sourceTitle}</a></span></dd></>)}</dl></section>}
      {area.faq && <section class="area-extra" aria-labelledby="area-faq"><h2 id="area-faq">Frequently asked questions</h2><FaqList items={area.faq} /></section>}
      {lastDate && <p class="area-updated">{area.dateModified ? 'Updated' : 'Published'} <time datetime={lastDate}>{postDates(lastDate).human}</time></p>}
    </div>
    <aside class="area-aside" aria-label="More about this area">
      <nav aria-labelledby="area-nearby">
        <h2 id="area-nearby" class="area-aside-head">{area.sidebar.nearbyLabel}</h2>
        <ul>{area.sidebar.nearby.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="area-guides">
        <h2 id="area-guides" class="area-aside-head">Related guides</h2>
        <ul>{area.sidebar.guides.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </aside>
  </div>
</section>
<CtaBand variant="area" cid={cid} heading={area.cta.heading} text={area.cta.text} button={{ href: site.nav.cta.href, label: site.nav.cta.label }} />
</main>
</Base>
