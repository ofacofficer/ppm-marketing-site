---
// A service-area (town) page, rendered from content/areas/<town>.json. Adding a town is one JSON
// file plus its hero photo in public/images/service-areas/; the URL, nav-free layout, sidebar, CTA,
// LocalBusiness/ProfessionalService and BreadcrumbList JSON-LD all come from here.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config.mjs';
import { scope } from '../components/scope.mjs';
import { expandTokens } from '../lib/tokens.mjs';
import areaCss from '../styles/area.css?raw';

export interface AreaData {
  name: string;
  county: string;
  /** Shows the "Rent Control Municipality" badge in the hero. */
  rentControl: boolean;
  seo: { title: string; description: string; social?: { title?: string; description?: string }; twitter?: { site?: boolean; title?: string; description?: string } };
  h1: string;
  intro: string;
  /** Hero photo: public/images/service-areas/<image>-hero.jpg, -hero.webp and -hero-768.webp. */
  hero?: { image: string; webpWidth: number; width: number; height: number; alt: string; creditHtml?: string };
  breadcrumbHubLabel: string;
  /** The town's own copy for the main column (services, market, at-a-glance, rent-control notes). */
  contentHtml: string;
  sidebar: { ctaText: string; nearbyLabel: string; nearby: { href: string; label: string }[]; guides: { href: string; label: string }[] };
  cta: { heading: string; text: string };
}
interface Props { slug: string; area: AreaData }
const { slug, area } = Astro.props;
const url = `${site.baseUrl}/service-areas/${slug}/`;
const cid = 'area';
const s = scope(cid);
const heroImg = area.hero && `/images/service-areas/${area.hero.image}-hero`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService',
    name: `${site.name} — ${area.name}, NJ`, url, telephone: site.phone.e164, priceRange: '$$',
    image: area.hero ? `${site.baseUrl}${heroImg}.jpg` : site.ogImage,
    areaServed: { '@type': 'City', name: area.name, addressRegion: 'NJ' },
    parentOrganization: { '@type': 'LocalBusiness', name: site.name, url: site.baseUrl },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.baseUrl}/` },
      { '@type': 'ListItem', position: 2, name: area.breadcrumbHubLabel, item: `${site.baseUrl}/service-areas/` },
      { '@type': 'ListItem', position: 3, name: area.name, item: url },
    ],
  },
];
---
<Base title={area.seo.title} description={area.seo.description} canonical={url} og={area.seo.social} twitter={area.seo.twitter} jsonLd={jsonLd} css={areaCss}>
<main id="main">   <Breadcrumbs variant="area" cid={cid} items={[{ href: '/', label: 'Home' }, { href: '/service-areas/', label: area.breadcrumbHubLabel }]} current={area.name} /> <section class={area.hero ? 'city-hero has-photo' : 'city-hero'} {...s}> {area.hero && <><picture><source type="image/webp" srcset={`${heroImg}-768.webp 768w, ${heroImg}.webp ${area.hero.webpWidth}w`} sizes="100vw"><img class="hero-photo" src={`${heroImg}.jpg`} alt={area.hero.alt} width={area.hero.width} height={area.hero.height} fetchpriority="high" decoding="async"></picture><div class="hero-scrim"></div>{area.hero.creditHtml && <div class="hero-credit" set:html={area.hero.creditHtml} />} </>}<div class="container" style={area.hero ? 'position:relative;z-index:2;' : undefined} {...s}> <span class="badge" {...s}>{area.county}</span>{area.rentControl && <><span class="badge" style="margin-left:8px;border-color:var(--error);color:var(--white);" {...s}> Rent Control Municipality</span></>} <h1 style="margin-top:16px;" {...s}>{area.h1}</h1> <p style="margin-top:16px;max-width:56ch;" {...s}>{area.intro}</p> <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;" {...s}> <a href="/contact/" class="btn btn-primary" {...s}>Get My Free Rental Analysis</a> <a href={`tel:${site.phone.tel}`} class="btn btn-ghost" {...s}>{site.phone.display}</a> </div> </div> </section> <section style="padding:64px 0;" {...s}> <div class="container city-grid" {...s}> <div class="prose-content" {...s}> <Fragment set:html={expandTokens(area.contentHtml)} /> </div> <aside class="city-sidebar" {...s}> <div class="sidebar-cta" {...s}> <div class="sidebar-cta-label" {...s}>Free rental analysis</div> <p class="text-sm text-muted" {...s}>{area.sidebar.ctaText}</p> <a href="/contact/" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:16px;" {...s}>Get Mine →</a> <div class="sidebar-contact" {...s}> <a href={`tel:${site.phone.tel}`} {...s}>{site.phone.display}</a> <a href={`mailto:${site.email}`} {...s}>{site.email}</a> </div> </div> <div class="nearby-areas" {...s}> <div class="nearby-label" {...s}>{area.sidebar.nearbyLabel}</div> {area.sidebar.nearby.map((l) => <><a href={l.href} {...s}>{l.label}</a> </>)}</div> <div class="nearby-areas" {...s}> <div class="nearby-label" {...s}>Related guides</div> {area.sidebar.guides.map((l) => <><a href={l.href} {...s}>{l.label}</a> </>)}</div> </aside> </div> </section> <CtaBand variant="area" cid={cid} heading={area.cta.heading} text={area.cta.text} button={{ href: '/contact/', label: 'Get My Free Rental Analysis' }} />  </main>
</Base>
