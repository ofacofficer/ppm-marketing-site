---
// A blog post, rendered from its content JSON (content/blog/<slug>.json) plus any sidecar in
// content/blog-extras/. Markup and CSS are the post template the site has always used
// (scripts/templates/post.html), now built from components.
//
// Phase 4: one column at the 65ch measure with a quiet aside (no cards), a statute-callout style for
// bodies that use <blockquote> or <aside class="statute"> (src/styles/post.css), and the published
// date stated as published: the post JSON has no review date, so the page claims none.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FAQ from '../components/FAQ.astro';
import { site, businessJsonLd } from '../site.config.mjs';
import { postBodyHtml, postDates, postJsonLd } from '../lib/post-body.mjs';
import postCss from '../styles/post.css?raw';

interface Props {
  post: { path: string; title: string; titleTag?: string; description: string; pillar: { name: string; path: string }; author: string; authorType: string; datePublished: string; body: string };
  extras?: { socialTitle?: string; faq?: { question: string; answer: string }[]; legalDisclaimer?: boolean };
}
const { post, extras = {} } = Astro.props;
const { url, pillarPath, posting, breadcrumb } = postJsonLd(post, site.baseUrl);
const dates = postDates(post.datePublished);
const titleTag = post.titleTag || post.title;
const socialTitle = extras.socialTitle ?? titleTag;
const cid = 'bvzihdzo';
const s = { [`data-astro-cid-${cid}`]: '' };
---
<Base
  title={titleTag}
  description={post.description}
  canonical={url}
  og={{ title: socialTitle }}
  jsonLd={[businessJsonLd, posting, breadcrumb]}
  css={postCss}
>
<FAQ slot="head" items={extras.faq ?? []} />
<main id="main">  <article class="blog-layout" {...s}> <Breadcrumbs cid={cid} items={[{ href: '/', label: 'Home' }, { href: '/blog/', label: 'Resources' }, { href: pillarPath, label: post.pillar.name }]} current={post.title} /> <header class="post-header" {...s}> <div class="container" {...s}> <a href={pillarPath} class="badge" style="margin-bottom:20px;display:inline-block;" {...s}> {post.pillar.name} </a> <h1 class="post-title" {...s}>{post.title}</h1>
<p class="blog-byline">By <span class="blog-byline-name">{post.author}</span>, published <time datetime={post.datePublished}>{dates.human}</time></p> </div> </header> <div class="post-body" {...s}> <div class="container post-grid" {...s}> <div class="prose-content" {...s}>  <Fragment set:html={postBodyHtml(post.body)} />  </div> <aside class="post-sidebar" aria-label={`More in ${post.pillar.name}`} {...s}> <div class="sidebar-cluster" {...s}> <div class="sidebar-cluster-label" {...s}>More in {post.pillar.name}</div> <a href={pillarPath} {...s}>Back to the {post.pillar.name} guide</a> </div> </aside> </div> </div> <CtaBand cid={cid} heading="Ready to stop managing and start owning?" text="Get a free rental analysis for your NJ property — no pitch, no pressure." button={{ href: '/contact/', label: site.nav.cta.label }} /> </article>  {extras.legalDisclaimer && <div class="wrap" style="padding:0 var(--gutter) 24px;"><p style="font-size:.8rem;color:var(--slate);max-width:none;"><em>This guide is general information for New Jersey landlords, not legal advice. Rules change and vary by municipality — verify current requirements with your municipality or a qualified New Jersey attorney before acting.</em></p></div>}</main>
</Base>
